# Local environments and caches
.venv/
.agents/
.codex/
.claude/
__pycache__/
*.py[cod]
*.csv
*.csv.gz
.mplconfig/
.Rhistory

# Generated LaTeX build files (PDFs remain available for sharing)
*.aux
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz

# Modular DP: keep the reproducible configs and curated full-profile outputs.
# Quick/smoke runs are local pipeline checks and should not duplicate figures or
# reports in Git.
Modular DP/figures/quick/
Modular DP/figures/smoke/
Modular DP/results/quick/
Modular DP/results/smoke/
# Discounted runs: keep curated plots and Markdown reports, not raw data tables
discounted/DP/outputs*/data/
discounted/DP/outputs*/**/*.csv
discounted/DP/outputs*/**/*.pkl
discounted/DP/outputs/plots/details/

# Independent paper repository synchronized with GitHub/Overleaf
discounted/OverleafPaper/
