      "sha256": "e107285cba6da9a73cbaf2dc9cc2dbdd1b3bf04cb1bab9d5b2538ec70c2b14c2",
      "source": "from pathlib import Path\nimport json\nfrom hashlib import sha256\nimport numpy as np\nfrom scipy.stats import wasserstein_distance\nfrom oblivious.oe_distribution_fixed_p0.code.run_experiment import check_bundle\nfrom oblivious.oe_distribution_fixed_p0.code.model import FixedOutsideMarginalExperiment, outside_demand_probability\nfrom oblivious.oe_p0.code.primitives import Parameters\nfrom oblivious.oe_p0.code.policy import evaluate_policy\nroot=Path('/home/natalia/Projects/LLM_Learning')\nhome=root/'oblivious/08_oe_distribution_fixed_p0'\nold=home/'data/p0_0p5'; oldm=json.loads((old/'manifest.json').read_text()); out=[]\nreviewpath=Path('/tmp/review_refinement.json'); oldreviews={(r['rho'],r['n']):r for r in json.loads(reviewpath.read_text())} if reviewpath.exists() else {}\nfor rho in [.95,.97]:\n d=home/'data/p0_0p5_refinement'/('rho_'+str(rho).replace('.','p'))\n if not (d/'manifest.json').exists():continue\n m=json.loads((d/'manifest.json').read_text())\n for path,digest in m['numerical_sources'].items():assert sha256((root/path).read_bytes()).hexdigest()==digest,path\n assert m['historical_seed']['manifest_sha256']==sha256((old/'manifest.json').read_bytes()).hexdigest()\n prev=check_bundle(old,m['historical_seed']['tag'],oldm)\n for tag in m['completed']:\n  case=check_bundle(d,tag,m); n=case['n']; p=Parameters(rho=rho)\n  if (rho,n) in oldreviews:\n   out.append(oldreviews[(rho,n)]);prev=case;continue\n  e=FixedOutsideMarginalExperiment(n=n,params=p,p0=.5,order=256)\n  cp=case['competition']; mp=case['monopoly']; a=cp['policy']; v=cp['actual_values']; nu=cp['nu'];mu=nu.sum(axis=0)\n  adaptive_error=0.0;probes=[]\n  mixed=np.flatnonzero((a>0)&(a<1));edges=np.flatnonzero(np.diff(a)!=0)\n  nodes=sorted(set([n//2]+mixed.tolist()+edges[-1:].tolist()))\n  for ii in nodes:\n   for jj in nodes:\n    direct=outside_demand_probability(e.grid[ii],e.grid[jj],p,.5);error=abs(direct-e.game.D[ii,jj]);adaptive_error=max(adaptive_error,error);probes.append(dict(i=int(ii),j=int(jj),absolute_error=float(error)))\n  assert adaptive_error<2e-9\n  full=e.game.transition(np.broadcast_to(a[:,None],(n,n)),np.broadcast_to(a[None,:],(n,n)))\n  ev=evaluate_policy(e.grid,e.game.D@mu,a,p)\n  regret=np.max(np.maximum(ev['advantage'],0)-a*ev['advantage'])\n  assert regret<=1e-10,(tag,regret)\n  stationary=float(abs(full.T@nu.ravel()-nu.ravel()).sum());assert stationary<1e-11\n  reward=e.game.D*(.95-.6*a[:,None])\n  value_resid=float(np.max(abs(reward.ravel()+p.gamma*(full@v[0].ravel())-v[0].ravel())))\n  assert value_resid<1e-9,(tag,value_resid)\n  diffmetrics={}\n  for model,r in [('monopoly',mp),('competition',cp)]:\n   earlier=prev[model]; grid=r['grid']; alpha=r['policy']; xold=earlier['grid']; aold=earlier['policy']\n   mass=r['mu'] if model=='monopoly' else r['nu'].sum(axis=0)\n   if model=='monopoly':sold=mass*r['demand']\n   else:sold=(r['nu']*e.game.D).sum(axis=1)\n   sale_law=sold/sold.sum();da=abs(alpha-np.interp(grid,xold,aold))\n   outcome=next(row for row in case['outcomes'] if row['model']==model)\n   assert abs(float(sold@alpha/sold.sum())-outcome['product2_conditional'])<1e-13\n   assert abs(float(sold@(.95-.6*alpha))-outcome['profit_calendar'])<1e-13\n   oldmass=earlier['mu'] if model=='monopoly' else earlier['nu'].sum(axis=0)\n   union=np.unique(np.r_[grid,xold]); cf=np.r_[0,np.cumsum(mass)];co=np.r_[0,np.cumsum(oldmass)]\n   cdf_f=cf[np.searchsorted(grid,union,side='right')];cdf_o=co[np.searchsorted(xold,union,side='right')]\n   diffmetrics[model]=dict(phase_edges=grid[np.flatnonzero(np.diff(alpha)!=0)].tolist(),mixed_nodes=np.flatnonzero((alpha>0)&(alpha<1)).tolist(),old_phase_edges=xold[np.flatnonzero(np.diff(aold)!=0)].tolist(),policy_uniform_integral=float(np.trapezoid(da,grid)),policy_calendar_weighted=float(mass@da),policy_sale_weighted=float(sale_law@da),distribution_wasserstein=float(wasserstein_distance(grid,xold,mass,oldmass)),distribution_cdf_sup=float(np.max(abs(cdf_f-cdf_o))))\n  row=dict(rho=rho,n=n,coarse_n=prev['n'],certificate_regret=float(regret),fresh_stationary_l1=stationary,fresh_joint_value_residual=value_resid,saved_stationary=cp['stationary_diagnostics'],demand_doubling=case['demand_audit']['order_doubling_max_error'],difference_metrics=diffmetrics,checkpoint_sha256={tag+s:m['checkpoint_sha256'][tag+s] for s in ['.json','.npz']},fresh_critical_demand_adaptive_max_abs_error=float(adaptive_error),fresh_critical_demand_probes=probes,economic_reconstruction_verified=True,economic_reconstruction_absolute_error_bound=1e-13)\n  out.append(row);prev=case;print(json.dumps(row),flush=True)\nPath('/tmp/review_refinement.json').write_text(json.dumps(out,indent=2))\n"
    },
