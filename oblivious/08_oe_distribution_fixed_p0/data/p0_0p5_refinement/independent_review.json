      "sha256": "02c78cc2a9b2371e697b1113703bd9dc5518aa74e148a5919e06488230e81085",
      "source": "from pathlib import Path\nfrom hashlib import sha256\nfrom datetime import datetime,timezone\nimport json,sys\nimport numpy as np\nsys.path.insert(0,'/home/natalia/Projects/LLM_Learning')\nfrom oblivious.oe_distribution_fixed_p0.code.run_experiment import check_bundle\nfrom oblivious.oe_following_monopoly.code.event_chain import purchase_chain_statistics\nfrom oblivious.oe_p0.code.primitives import Parameters\nroot=Path('/home/natalia/Projects/LLM_Learning');base=root/'oblivious/08_oe_distribution_fixed_p0/data/p0_0p5_refinement'\nreviews=json.loads(Path('/tmp/review_refinement.json').read_text());lookup={(r['rho'],r['n']):r for r in reviews}\ninputs={};manifests={};sources={};economic=[];comparisons=[]\ndef digest(p):return sha256(Path(p).read_bytes()).hexdigest()\nfor rho in [.95,.97]:\n d=base/('rho_'+str(rho).replace('.','p'));m=json.loads((d/'manifest.json').read_text())\n assert m['status']!='running' and m.get('current_grid') is None,(rho,m['status'])\n assert not m['failures'];assert len(m['completed'])==3;assert all((rho,n) in lookup for n in [101,151,201])\n manifests[str(rho)]={str((d/'manifest.json').relative_to(root)):digest(d/'manifest.json')}\n for source,expected in m['numerical_sources'].items():assert digest(root/source)==expected;sources[source]=expected\n for field in ['supplemental_search_provenance','diagnostic_artifacts']:\n  for local,expected in m.get(field,{}).items():\n   p=d/local;assert digest(p)==expected;inputs[str(p.relative_to(root))]=expected\n old=root/m['historical_seed']['directory'];om=json.loads((old/'manifest.json').read_text());tag=m['historical_seed']['tag'];oldcase=check_bundle(old,tag,om)\n for ext in ['.json','.npz']:inputs[str((old/'arrays'/(tag+ext)).relative_to(root))]=digest(old/'arrays'/(tag+ext))\n cases=[]\n for tag in m['completed']:\n  c=check_bundle(d,tag,m);cases.append(c);review=lookup[(rho,c['n'])];review['checkpoint_sha256']={}\n  for ext in ['.json','.npz']:\n   p=d/'arrays'/(tag+ext);got=digest(p);assert got==m['checkpoint_sha256'][p.name];inputs[str(p.relative_to(root))]=got;review['checkpoint_sha256'][str(p.relative_to(root))]=got\n  p=Parameters(**c['configuration']['parameters'])\n  for model in ['monopoly','competition']:\n   r=c[model];assert r['verified'];row=next(x for x in c['outcomes'] if x['model']==model);n=c['n'];a=r['policy']\n   event=purchase_chain_statistics(r['grid'],a,p);eta=event['sale_stationary'];event_use=float(eta@a)\n   initial=float(r['value'][n//2]) if model=='monopoly' else float(r['actual_values'][:,n//2,n//2].mean())\n   errors=dict(product2_calendar_identity=abs(row['product2_calendar']-row['sale_rate']*row['product2_conditional']),profit_identity=abs(row['profit_calendar']-row['sale_rate']*(p.R-p.c1-(p.c2-p.c1)*row['product2_conditional'])),actual_initial_value_match=abs(initial-row['value_initial']),event_chain_product2_use=abs(event_use-row['product2_conditional']),event_chain_reputation_quality=abs(float(eta@r['grid'])-(p.p1+(p.p2-p.p1)*event_use)),market_partition=abs(row['outside_rate']+(2 if model=='competition' else 1)*row['sale_rate']-1))\n   assert max(errors.values())<1e-9,(rho,n,model,errors)\n   economic.append(dict(rho=rho,n=n,model=model,verified=True,absolute_errors=errors))\n  if c['n']>101:\n   coarse=cases[-2]\n   for model in ['monopoly','competition']:\n    x=np.unique(np.r_[coarse[model]['grid'],c[model]['grid']]);delta=abs(np.interp(x,coarse[model]['grid'],coarse[model]['policy'])-np.interp(x,c[model]['grid'],c[model]['policy']))\n    review['difference_metrics'][model]['policy_sup_difference_linear_extensions']=float(delta.max())\n fine=cases[-1];coarse=cases[-2]\n for model in ['monopoly','competition']:\n  a=next(x for x in coarse['outcomes'] if x['model']==model);b=next(x for x in fine['outcomes'] if x['model']==model)\n  pd={k:abs(a[k]-b[k]) for k in ['sale_rate','product2_calendar','product2_conditional']};rd={k:abs(a[k]-b[k])/max(abs(a[k]),abs(b[k])) for k in ['profit_calendar','value_initial']}\n  comparisons.append(dict(rho=rho,model=model,coarse_n=coarse['n'],fine_n=fine['n'],passed=all(x<=.05 for x in [*pd.values(),*rd.values()]),absolute_probability_changes=pd,symmetric_relative_earnings_changes=rd))\nartifact=dict(created_utc=datetime.now(timezone.utc).isoformat(),audit='Independent checks of the completed fixed-p0 grid refinement',scope=dict(economic_model='Unchanged marginal-distribution OE, two endogenous sellers plus known fixed p0=.5, same monopoly benchmark',new_grids=[101,151,201],rho=[.95,.97],fresh_checks='Checkpoint/source/seed checksums; reconstructed demand and full joint calendar kernel; stationary residual; conditional optimality; actual joint discounted-value Bellman residual; recomputed product-2 and profit outcomes; policy and marginal-distribution comparisons',positive_stationarity='Audited saved subtraction-free GTH certificate and independent-order agreement. The independent residual audit did not rerun the costly positive solver for every grid.',local_policy='Aggregate grid stability is separate from local changes at discontinuous action boundaries or mixing nodes. Weighted and uniform policy differences and marginal Wasserstein distances are retained.',limitations=['No proof of continuous-state convergence.','No proof of uniqueness or exhaustive equilibrium enumeration.','Step-CDF sup distances can remain sensitive to atoms moving between grids.','Finite-grid certification applies to the stored demand quadrature and interpolation model.']),all_six_refined_cases_passed_independent_audit=True,input_artifact_sha256=inputs,checkpoint_bundle_sha256={k:v for k,v in inputs.items() if \"/arrays/\" in k},per_rho_manifest_sha256=manifests,numerical_source_sha256=sources,review_scripts={str(p):dict(sha256=digest(p),source=Path(p).read_text()) for p in ['/tmp/review_refinement.py','/tmp/finalize_independent_review.py']},case_audits=reviews,economic_identity_audits=economic,final_consecutive_grid_comparisons=comparisons)\nassert len(reviews)==6;assert all(r['passed'] for r in comparisons)\n(base/'independent_review.json').write_text(json.dumps(artifact,indent=2)+'\\n');Path('/tmp/review_refinement.json').write_text(json.dumps(reviews,indent=2)+'\\n')\nprint(base/'independent_review.json');print(json.dumps(comparisons,indent=2))\n"
